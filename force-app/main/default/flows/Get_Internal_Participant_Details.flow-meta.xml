<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds count to a variable</description>
        <name>Add_count</name>
        <label>Increment Total Internal Participants</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>InternalRoleParticipated</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CurrentRoleMatchCount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Thru_Role_List</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Counts how many call participants matched the current CMDT role being evaluated</description>
        <name>Set_Current_Role_Match_Count</name>
        <label>Set Current Role Match Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CurrentRoleMatchCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>filter_for_participant</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Did_Role_Match_Participant</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Marks that Brian (PM) was found among the call participants</description>
        <name>Set_PM_On_Call</name>
        <label>Set PM On Call</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>PM_OnCall</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_count</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets InternalRoleAttended to Both when both PM and SE are on the call</description>
        <name>Set_Role_Both</name>
        <label>Set Role Both</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>InternalRoleAttended</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Both</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets InternalRoleAttended to PM when only Brian is on the call</description>
        <name>Set_Role_PM</name>
        <label>Set Role PM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>InternalRoleAttended</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>PM</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets InternalRoleAttended to SE when only Tom is on the call</description>
        <name>Set_Role_SE</name>
        <label>Set Role SE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>InternalRoleAttended</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SE</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Marks that Tom (SE) was found among the call participants</description>
        <name>Set_SE_On_Call</name>
        <label>Set SE On Call</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SE_OnCall</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_count</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <description>count an idividual participant</description>
        <name>filter_for_participant</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>filter for participant</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_filter_for_participant</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Participants</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_filter_for_participant.Email</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_Thru_Role_List.Email_Address__c</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Set_Current_Role_Match_Count</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <description>Sets the final InternalRoleAttended value based on whether PM, SE, both, or neither were found on the call</description>
        <name>Determine_Final_Internal_Role</name>
        <label>Determine Final Internal Role</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>PM_Only</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PM_OnCall</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SE_OnCall</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Role_PM</targetReference>
            </connector>
            <label>PM Only</label>
        </rules>
        <rules>
            <name>SE_Only</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SE_OnCall</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PM_OnCall</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Role_SE</targetReference>
            </connector>
            <label>SE Only</label>
        </rules>
        <rules>
            <name>Both_PM_and_SE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PM_OnCall</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SE_OnCall</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Role_Both</targetReference>
            </connector>
            <label>Both PM and SE</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if a CMDT role was found among call participants, and if so, which role it was</description>
        <name>Did_Role_Match_Participant</name>
        <label>Did Role Match Participant</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_count</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>PM_Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CurrentRoleMatchCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Thru_Role_List.Role__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_PM_On_Call</targetReference>
            </connector>
            <label>PM Matched</label>
        </rules>
        <rules>
            <name>SE_Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CurrentRoleMatchCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Thru_Role_List.Role__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_SE_On_Call</targetReference>
            </connector>
            <label>SE Matched</label>
        </rules>
    </decisions>
    <description>Returns the internal video call participant count and role</description>
    <environments>Default</environments>
    <interviewLabel>Get Internal Participant Details {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Internal Participant Details</label>
    <loops>
        <description>Looop through CMDT to count internal roles participating</description>
        <name>Loop_Thru_Role_List</name>
        <label>Loop Thru Role List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Internal_Role_Users</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>filter_for_participant</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Determine_Final_Internal_Role</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Internal_Role_Users</name>
        <label>Get Internal Role Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Thru_Role_List</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>VidCall_RecMatch_Int_Part_Classify__mdt</object>
        <sortField>Priority_Order__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets participants</description>
        <name>Get_Participants</name>
        <label>Get Participants</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Internal_Role_Users</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>VideoCallId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VideoCallId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>VideoCallParticipant</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Participants</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_filter_for_participant</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>VideoCallParticipant</objectType>
    </variables>
    <variables>
        <name>currentItemFromSourceCollection</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>VideoCallParticipant</objectType>
    </variables>
    <variables>
        <description>Temporary count of matches for the current CMDT role being evaluated in the loop</description>
        <name>CurrentRoleMatchCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <description>A text string returned that spedifies the role</description>
        <name>InternalRoleAttended</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>None</stringValue>
        </value>
    </variables>
    <variables>
        <description>Count of how many with classification role attended</description>
        <name>InternalRoleParticipated</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <description>True if Brian (PM) is found among call participants</description>
        <name>PM_OnCall</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>True if Tom (SE) is found among call participants</description>
        <name>SE_OnCall</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Id of the VideoCall used to lookup internal participants</description>
        <name>VideoCallId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
