<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Needs_Update</name>
        <label>Mismatch Flag Needs Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No change needed</defaultConnectorLabel>
        <rules>
            <name>Value_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Ramp_Start_Date_Mismatch__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>varIsMismatch</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Quote_Mismatch_Flag</targetReference>
            </connector>
            <label>Value changed</label>
        </rules>
    </decisions>
    <description>Recalculates Quote.Ramp_Start_Date_Mismatch__c when a Ramp Schedule segment (QuoteLineGroup) is deleted. If the segment being deleted was the earliest (first) one, the next-earliest segment becomes &quot;first&quot; and the flag must be re-evaluated against it; without this, deleting the first segment left the flag stale. Passes the segment being deleted as ExcludeSegmentId to the shared subflow so the &quot;earliest segment&quot; lookup ignores it (the record still exists in the database at before-delete time). Complements QLG_Set_Ramp_Start_Date_Mismatch (create/update of a segment) and Quote_Recalculate_Ramp_Start_Date_Mismatch (Quote Start Date edited).</description>
    <environments>Default</environments>
    <interviewLabel>QLG Recalculate Ramp Start Date Mismatch On Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QLG - Recalculate Ramp Start Date Mismatch On Delete</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Mismatch</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>StartDate</queriedFields>
        <queriedFields>Ramp_Start_Date_Mismatch__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote_Mismatch_Flag</name>
        <label>Update Quote Mismatch Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Ramp_Start_Date_Mismatch__c</field>
            <value>
                <elementReference>varIsMismatch</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote</targetReference>
        </connector>
        <filterFormula>{!$Record.IsRamped}</filterFormula>
        <object>QuoteLineGroup</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Evaluate_Mismatch</name>
        <label>Evaluate Ramp Start Date Mismatch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Needs_Update</targetReference>
        </connector>
        <flowName>Evaluate_Ramp_Start_Date_Mismatch</flowName>
        <inputAssignments>
            <name>QuoteId</name>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>QuoteStartDate</name>
            <value>
                <elementReference>Get_Quote.StartDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>ExcludeSegmentId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varIsMismatch</assignToReference>
            <name>IsMismatch</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>varIsMismatch</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
