<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Does the name need to be updated?</description>
        <name>Name_Needs_Updated</name>
        <label>Name Needs Updated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SourceOpportunity.Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SourceOpportunityId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>forDT_Now</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>ForDT_CreatedDatePlus10Seconds</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Contract_Name</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>A flow that runs after the Contract is saved.</description>
    <environments>Default</environments>
    <formulas>
        <description>Name of the contract</description>
        <name>ContractName</name>
        <dataType>String</dataType>
        <expression>{!$Record.SourceOpportunity.Name}</expression>
    </formulas>
    <formulas>
        <name>forB_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>ForDT_CreatedDatePlus10Seconds</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.CreatedDate} + (10 / 86400)</expression>
    </formulas>
    <formulas>
        <name>forDT_Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Contract After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Set the name of the contract</description>
        <name>Set_Contract_Name</name>
        <label>Set Contract Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>$Record.SourceOpportunity.Name</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Name_Needs_Updated</targetReference>
        </connector>
        <object>Contract</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
