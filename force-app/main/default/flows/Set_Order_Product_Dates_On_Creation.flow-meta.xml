    <decisions>
        <description>Positive-quantity line created from a quote line with a PricingTermCount: total must use that term (matches the quote). Everything else (reductions/cancellations, lines without a quote line) keeps the existing calendar-month formula via Assign_NetTotalPrice.</description>
        <name>Use_Quote_Term_For_Total</name>
        <label>Use Quote Term for Total?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_NetTotalPrice</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - keep existing formula</defaultConnectorLabel>
        <rules>
            <name>Yes_Quote_Based</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QLI_For_PTC</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QLI_For_PTC.PricingTermCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PricingTermCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NetTotalPrice_QLI</targetReference>
            </connector>
            <label>Yes - quote-based line</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>varNetTotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.NetUnitPrice} * {!$Record.Quantity} * {!varPricingTermCount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varNetTotalPrice_OneTime</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.NetUnitPrice} * {!$Record.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>NetTotalPrice using the line&apos;s own PricingTermCount (from the quote line), e.g. 125 x 100 x 36.5333 = 456,666.67, instead of the calendar-month varPricingTermCount (37).</description>
        <name>varNetTotalPrice_QLI</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.NetUnitPrice} * {!$Record.Quantity} * {!$Record.PricingTermCount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varNetTotalPrice_Ramp</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.NetUnitPrice} * {!$Record.Quantity} * {!varPricingTermCount_Ramp}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varPricingTermCount</name>
        <dataType>Number</dataType>
        <expression>(YEAR({!$Record.EndDate} + 1) - YEAR({!Get_Order.EffectiveDate})) * 12 + MONTH({!$Record.EndDate} + 1) - MONTH({!Get_Order.EffectiveDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varPricingTermCount_Ramp</name>
        <dataType>Number</dataType>
        <expression>(YEAR({!$Record.EndDate} + 1) - YEAR({!Get_QLI_For_Ramp.StartDate})) * 12 + MONTH({!$Record.EndDate} + 1) - MONTH({!Get_QLI_For_Ramp.StartDate})</expression>
        <scale>0</scale>
    </formulas>
