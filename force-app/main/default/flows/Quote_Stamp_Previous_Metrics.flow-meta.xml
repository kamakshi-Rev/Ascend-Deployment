<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Stamp_Previous_Metrics</name>
        <label>Stamp Previous Metrics</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>FinancialMetricsStampPreviousInvocable</actionName>
        <actionType>apex</actionType>
        <faultConnector>
            <targetReference>Log_Financial_Metrics_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>quoteId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>FinancialMetricsStampPreviousInvocable</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Automation 1. On creation of an amendment, cancellation or renewal quote against a contract, copies the contract financial baseline into the quote EXISTING set. New business quotes have no contract and are skipped, leaving the Existing fields blank.</description>
    <environments>Default</environments>
    <interviewLabel>Quote Stamp Previous Metrics {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Stamp Previous Metrics</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Financial_Metrics_Fault</name>
        <label>Log Financial Metrics Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Financial Metrics Fault</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Previous_Metrics</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.ContractId})),
  OR(
    TEXT({!$Record.OriginalActionType}) = &quot;Amend&quot;,
    TEXT({!$Record.OriginalActionType}) = &quot;Cancel&quot;,
    TEXT({!$Record.OriginalActionType}) = &quot;Renew&quot;
  )
)</filterFormula>
        <object>Quote</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
