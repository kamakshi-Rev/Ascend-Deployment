<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_First_Segment_Date</name>
        <label>Assign First Segment Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFirstSegmentStartDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_First_Segment.StartDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Output</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_First_Segment_Date_Excluding</name>
        <label>Assign First Segment Date (Excluding)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFirstSegmentStartDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_First_Segment_Excluding.StartDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Output</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Output</name>
        <label>Assign Output</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>IsMismatch</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IsMismatchFormula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Exclude_Id</name>
        <label>Excluding a Segment?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_First_Segment_Excluding</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has exclusion</defaultConnectorLabel>
        <rules>
            <name>No_Exclude_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ExcludeSegmentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_First_Segment</targetReference>
            </connector>
            <label>No exclusion</label>
        </rules>
    </decisions>
    <description>Shared logic for whether a Quote&apos;s Ramp Start Date Mismatch flag should be true: compares the Quote&apos;s StartDate to the earliest (first) Ramp Schedule (QuoteLineGroup) segment&apos;s StartDate for that Quote. &quot;First segment&quot; is the earliest StartDate, not SortOrder = 1, since SortOrder on QuoteLineGroup is not reliable. Called by QLG_Set_Ramp_Start_Date_Mismatch, Quote_Recalculate_Ramp_Start_Date_Mismatch, and QLG_Recalculate_Ramp_Start_Date_Mismatch_On_Delete so the comparison formula (including blank-date handling) lives in exactly one place. ExcludeSegmentId is optional and is used only by the before-delete caller, to exclude the segment being deleted from the &quot;earliest segment&quot; lookup.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsMismatchFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!varFirstSegmentStartDate}), false, IF(ISBLANK({!QuoteStartDate}), true, {!varFirstSegmentStartDate} &lt;&gt; {!QuoteStartDate}))</expression>
    </formulas>
    <interviewLabel>Evaluate Ramp Start Date Mismatch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Evaluate Ramp Start Date Mismatch (QuoteId)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_First_Segment</name>
        <label>Get Earliest Ramp Segment for Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_First_Segment_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>QuoteId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsRamped</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineGroup</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>StartDate</queriedFields>
        <sortField>StartDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_First_Segment_Excluding</name>
        <label>Get Earliest Ramp Segment for Quote (Excluding One)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_First_Segment_Date_Excluding</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>QuoteId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsRamped</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>ExcludeSegmentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineGroup</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>StartDate</queriedFields>
        <sortField>StartDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Exclude_Id</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>ExcludeSegmentId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>IsMismatch</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>QuoteId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>QuoteStartDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varFirstSegmentStartDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
