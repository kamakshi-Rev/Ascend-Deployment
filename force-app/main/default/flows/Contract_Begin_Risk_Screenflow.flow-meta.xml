    <formulas>
        <description>Calculates the annualized at risk revenue for the asset</description>
        <name>f_AnnualizedAtRiskRevenue</name>
        <dataType>Currency</dataType>
        <expression>{!Loop_Through_the_Selected_Assets.Asset.CurrentMrr} * 12</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Checks to see if the LOB is already in the var_LOB</description>
        <name>f_ChecksLOB</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(
    &quot;;&quot; &amp; {!var_LOB} &amp; &quot;;&quot;,
    &quot;;&quot; &amp; TEXT({!Loop_Through_the_Selected_Assets.Asset.Product2.Service_Offering__c}) &amp; &quot;;&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Stores the churn case record type id</description>
        <name>f_ChurnCaseRecordTypeId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Churn_Case_Record_Type_Id}</expression>
    </formulas>
    <formulas>
        <description>Adds the LOBs</description>
        <name>f_LOB</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!var_LOB}),
    TEXT({!Loop_Through_the_Selected_Assets.Asset.Product2.Service_Offering__c}),
    {!var_LOB} &amp;
    &quot;;&quot; &amp;
    TEXT({!Loop_Through_the_Selected_Assets.Asset.Product2.Service_Offering__c})
)</expression>
    </formulas>
    <formulas>
        <description>Names the subject field on the case</description>
        <name>f_SubjectName</name>
        <dataType>String</dataType>
        <expression>&quot;At Risk - &quot; + {!Get_the_Contract_Record.Name}</expression>
    </formulas>
