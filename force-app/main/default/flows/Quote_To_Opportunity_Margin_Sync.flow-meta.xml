<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Ps_Or_MS_Opportunity</name>
        <label>Check Ps Or MS Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Renewal_Or_Not</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Professional Services</defaultConnectorLabel>
        <rules>
            <name>Its_PS_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Professional Services</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Update_Opportunity_Margin_Fields</targetReference>
            </connector>
            <label>Its PS Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Renewal_Or_Not</name>
        <label>Check Renewal Or Not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_2_of_Update_Opportunity_Margin_Fields</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Its_Renewal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OriginalActionType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renew</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Margin_Fields</targetReference>
            </connector>
            <label>Its Renewal</label>
        </rules>
    </decisions>
    <description>Syncs Margin, MRR/TCV and Contract Term fields from a synced Quote to its Opportunity when the Quote starts syncing or one of the synced fields changes. Running on every Quote save (v2) updated the Opportunity many times per renewal and pushed InitiateRenewal past SOQL/CPU limits.</description>
    <environments>Default</environments>
    <interviewLabel>Quote To Opportunity Margin Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote To Opportunity Margin Sync</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
