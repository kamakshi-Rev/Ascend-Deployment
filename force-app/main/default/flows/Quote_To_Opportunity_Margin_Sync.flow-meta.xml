    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Ps_Or_MS_Opportunity</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.IsSyncing},
    OR(
        ISNEW(),
        ISCHANGED({!$Record.IsSyncing}),
        ISCHANGED({!$Record.StartDate}),
        ISCHANGED({!$Record.Contract_Term_Months__c}),
        ISCHANGED({!$Record.Annual_Increase__c}),
        ISCHANGED({!$Record.Auto_Renew_Increase__c}),
        ISCHANGED({!$Record.Booked_MRR__c}),
        ISCHANGED({!$Record.Current_MRR__c}),
        ISCHANGED({!$Record.Existing_MRR__c}),
        ISCHANGED({!$Record.Current_TCV__c}),
        ISCHANGED({!$Record.Existing_TCV__c}),
        ISCHANGED({!$Record.Margin_Total__c}),
        ISCHANGED({!$Record.Margin_Cyber__c}),
        ISCHANGED({!$Record.Margin_Desk__c}),
        ISCHANGED({!$Record.Margin_Infra__c}),
        ISCHANGED({!$Record.Margin_Onboarding__c}),
        ISCHANGED({!$Record.Margin_Private_Cloud__c}),
        ISCHANGED({!$Record.Margin_VOIP__c})
    )
)</filterFormula>
