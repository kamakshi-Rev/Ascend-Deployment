<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Needs_Update</name>
        <label>Mismatch Flag Needs Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No change needed</defaultConnectorLabel>
        <rules>
            <name>Value_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Ramp_Start_Date_Mismatch__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>varIsMismatch</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Quote_Mismatch_Flag</targetReference>
            </connector>
            <label>Value changed</label>
        </rules>
    </decisions>
    <description>Keeps Quote.Ramp_Start_Date_Mismatch__c in sync with whether the Quote&apos;s Start Date matches the earliest (first) Ramp Schedule segment&apos;s Start Date. Only evaluates on a new segment or when the segment&apos;s StartDate actually changes, since ramp segments are often updated in bulk (e.g. repricing) without touching dates. The comparison itself (including blank-date handling) lives in the shared subflow Evaluate_Ramp_Start_Date_Mismatch, also used by Quote_Recalculate_Ramp_Start_Date_Mismatch and QLG_Recalculate_Ramp_Start_Date_Mismatch_On_Delete.</description>
    <environments>Default</environments>
    <interviewLabel>QLG Set Ramp Start Date Mismatch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QLG - Set Ramp Start Date Mismatch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Mismatch</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>StartDate</queriedFields>
        <queriedFields>Ramp_Start_Date_Mismatch__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote_Mismatch_Flag</name>
        <label>Update Quote Mismatch Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Ramp_Start_Date_Mismatch__c</field>
            <value>
                <elementReference>varIsMismatch</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.IsRamped},
    OR(
        ISNEW(),
        ISCHANGED({!$Record.StartDate})
    )
)</filterFormula>
        <object>QuoteLineGroup</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Evaluate_Mismatch</name>
        <label>Evaluate Ramp Start Date Mismatch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Needs_Update</targetReference>
        </connector>
        <flowName>Evaluate_Ramp_Start_Date_Mismatch</flowName>
        <inputAssignments>
            <name>QuoteId</name>
            <value>
                <elementReference>Get_Quote.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>QuoteStartDate</name>
            <value>
                <elementReference>Get_Quote.StartDate</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varIsMismatch</assignToReference>
            <name>IsMismatch</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>varIsMismatch</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
