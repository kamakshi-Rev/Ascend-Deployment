    <decisions>
        <name>Check_Contract_Date_Valid</name>
        <label>Are QLI Dates valid for linked Contract?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Amend_Dates_Clear_Contract</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contract or Date Conflict — Clear ContractId</defaultConnectorLabel>
        <rules>
            <name>Contract_Date_Valid</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract_For_Amend</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QLI_For_Amend.StartDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Contract_For_Amend.StartDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contract_For_Amend.EndDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QLI_For_Amend.EndDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Contract_For_Amend.EndDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Amend_Dates_Keep_Contract</targetReference>
            </connector>
            <label>QLI Dates valid — Keep ContractId</label>
        </rules>
    </decisions>
