    <decisions>
        <name>Check_OriginalActionType</name>
        <label>Check Order Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Match — Exit</defaultConnectorLabel>
        <rules>
            <name>Is_Amend</name>
            <conditionLogic>1 OR 2 OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OriginalActionType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Amend</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OriginalActionType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renew</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OriginalActionType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancel</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_For_Address</targetReference>
            </connector>
            <label>Is Amend / Renew / Cancel — Set QLI Dates</label>
        </rules>
        <rules>
            <name>Not_Amend_Renew_Cancel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OriginalActionType</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Amend</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OriginalActionType</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Renew</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OriginalActionType</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancel</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote</targetReference>
            </connector>
            <label>Not Amend / Renew / Cancel — Continue</label>
        </rules>
    </decisions>
