    </recordLookups>
    <recordLookups>
        <name>Get_Quotes_On_Opportunity</name>
        <label>Get Quotes On Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assignment_1</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Quote</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contract_Term</name>
        <label>Update Contract Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
        <inputAssignments>
            <field>Auto_Renew_Increase__c</field>
            <value>
                <elementReference>Get_Contract_Record.Auto_Renew_Increase__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Term_Months__c</field>
            <value>
                <elementReference>$Record.Contract.RenewalTerm2</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opp</name>
        <label>Update Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Opp_Description</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContractId</field>
            <value>
                <elementReference>Get_Contract_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Version__c</field>
            <value>
                <elementReference>Get_Old_Opportunity_Record.Contract_Version__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadSource</field>
            <value>
                <elementReference>Get_Old_Opportunity_Record.LeadSource</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentOpportunity__c</field>
            <value>
                <elementReference>Get_Old_Opportunity_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_Old_Opportunity_Record.RecordTypeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Referral_Secondary__c</field>
            <value>
                <elementReference>Get_Old_Opportunity_Record.Referral_Secondary__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Referred_By__c</field>
            <value>
                <elementReference>Get_Old_Opportunity_Record.Referred_By__c</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <description>No Source Opportunity on the contract: only link the contract. Referral, Lead Source and Record Type set when the opportunity was created are kept.</description>
        <name>Update_Opp_Contract_Only</name>
        <label>Update Opportunity Contract Only</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Quote_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContractId</field>
            <value>
                <elementReference>Get_Contract_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <description>Copies the parent (original) opportunity&apos;s Opportunity Description onto the new Amend/Renew/Cancel opportunity. Only matches when the new opportunity&apos;s description is still blank or the field default &apos;No Description&apos; (Cancel/Full Churn opportunities are created with the default), so a description someone has already entered is never overwritten. Needed because Opportunity_BeforeTriggerFlow only copies it on insert (isNew), before ParentOpportunity__c is set by Update_Opp. Fault path continues so a failure here never blocks the rest of this flow.</description>
        <name>Update_Opp_Description</name>
        <label>Update Opportunity Description</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Contact_Roles</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Parent_Contact_Roles</targetReference>
        </faultConnector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Opportunity_Description__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Opportunity_Description__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>No Description</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Opportunity_Description__c</field>
            <value>
                <elementReference>Get_Old_Opportunity_Record.Opportunity_Description__c</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Quote_Name</name>
        <label>Update Quote Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>QuoteName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StartDate</field>
            <value>
                <elementReference>$Record.Opportunity.Est_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Amend_Renewal_Quote</targetReference>
        </connector>
        <object>Quote</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
