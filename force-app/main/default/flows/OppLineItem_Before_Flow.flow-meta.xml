                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Segment_Flag</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Runs before Update or Insert</description>
    <environments>Default</environments>
    <formulas>
        <description>Quantity of the quote line of THIS ramp segment; falls back to the product-only lookup for non-ramp lines or when no segment line is found.</description>
        <name>fLineQuantity</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Quote_Line_Item_By_Segment.Id})), {!Get_Quote_Line_Item_By_Segment.Quantity}, {!Get_Quote_Line_Item.Quantity})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Term of the quote line of THIS ramp segment (same product and start date); falls back to the product-only lookup for non-ramp lines or when no segment line is found.</description>
        <name>fLineTerm</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Quote_Line_Item_By_Segment.Id})), {!Get_Quote_Line_Item_By_Segment.PricingTermCount}, {!Get_Quote_Line_Item.PricingTermCount})</expression>
        <scale>8</scale>
    </formulas>
    <formulas>
        <description>Multiply the Devices by months or hours</description>
        <name>QuantityCalc</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Term__c} * {!$Record.DevicesHours__c}</expression>
        <scale>0</scale>
    </formulas>
