<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Asset_Id</name>
        <label>Collect Asset Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_AssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_ACRs.AssetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_ACRs</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>All_Assets_Ended</name>
        <label>All Contract Assets Ended?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Change Needed</defaultConnectorLabel>
        <rules>
            <name>All_Ended</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Asset</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contract.Contract_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Contract Terminated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Contract_Terminated</targetReference>
            </connector>
            <label>Yes - Mark Terminated</label>
        </rules>
        <rules>
            <name>Still_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Asset</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contract.Contract_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract Terminated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Contract_Terminated</targetReference>
            </connector>
            <label>No - Clear Terminated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Did_End_Date_Change</name>
        <label>Did Lifecycle End Date Change?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No - Stop</defaultConnectorLabel>
        <rules>
            <name>End_Date_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LifecycleEndDate</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.LifecycleEndDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contract_Relationship</targetReference>
            </connector>
            <label>Yes - Re-evaluate Contract</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Contract</name>
        <label>Has Contract?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No - Stop</defaultConnectorLabel>
        <rules>
            <name>Contract_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract_Relationship</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contract</targetReference>
            </connector>
            <label>Yes - Contract Found</label>
        </rules>
    </decisions>
    <description>Keeps Contract.Contract_Terminated__c in sync with the assets on the contract. Runs on Asset after save (Update) whenever LifecycleEndDate is populated, plus a scheduled path that fires on the asset&apos;s own LifecycleEndDate so future-dated cancellations are picked up when that date actually arrives. Collects every Asset on the contract via AssetContractRelationship, then runs a single query for any asset that is still open (LifecycleEndDate after today). Assets with a null LifecycleEndDate count as ended, not open - see the note on Get_Open_Asset. If none are found, every asset ended on or before today and Contract_Terminated__c is set to true. If an open asset is found and the flag is already true (a cancellation was reversed or an end date extended), the flag is cleared. No SOQL runs inside the loop.

ML - Updated to set Contract Status to Contract Terminated instead of Contract Terminated Checkbox.</description>
    <environments>Default</environments>
    <interviewLabel>onAsset - Cancel TermDefined - Set Contract Terminated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>onAsset - Cancel TermDefined - Set Contract Terminated</label>
    <loops>
        <name>Loop_ACRs</name>
        <label>Loop Over Contract Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Contract_ACRs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Asset_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Asset</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Contract_ACRs</name>
        <label>Get All Assets on Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_ACRs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContractId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract_Relationship.ContractId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AssetContractRelationship</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contract</name>
        <label>Get Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_All_Contract_ACRs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract_Relationship.ContractId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contract_Relationship</name>
        <label>Get Contract from Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Contract</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AssetContractRelationship</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ContractId</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Returns the first asset on the contract whose LifecycleEndDate is after today. A null LifecycleEndDate is deliberately NOT treated as open: OneTime assets are created without one (Asset_OneTime_LifecycleEndDate is inactive in the org), and they would otherwise block their contract forever. Trade-off: a genuinely live asset that never received an end date is also ignored here. If nothing comes back, every asset that has an end date ended on or before today.</description>
        <name>Get_Open_Asset</name>
        <label>Get Any Still-Open Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>All_Assets_Ended</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>var_AssetIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>LifecycleEndDate</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>LifecycleEndDate</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Clear_Contract_Terminated</name>
        <label>Clear Contract Terminated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Contract_Status__c</field>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </inputAssignments>
        <object>Contract</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Contract_Terminated</name>
        <label>Set Contract Terminated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Contract_Status__c</field>
            <value>
                <stringValue>Contract Terminated</stringValue>
            </value>
        </inputAssignments>
        <object>Contract</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Did_End_Date_Change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LifecycleEndDate</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Asset</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>On_Lifecycle_End_Date</name>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_Contract_Relationship</targetReference>
            </connector>
            <label>On Lifecycle End Date</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>LifecycleEndDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_AssetIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
