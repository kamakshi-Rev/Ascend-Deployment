    <decisions>
        <name>Check_if_its_Null</name>
        <label>Check If Its Renewal Quote Or Not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Its_Not</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.Contract_Term_Months__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contracts</targetReference>
            </connector>
            <label>Its yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether GetApplicationUsageAssignment returned an application usage assignment record.</description>
        <name>HaveApplicationUsageAssignmentRecord</name>
        <label>Have Application Usage Assignment Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CreateOrUpdateRelatedAsset</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (Default)</defaultConnectorLabel>
        <rules>
            <name>HaveRecord</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AppUsageAssignment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateOrUpdateRelatedAsset</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Assetize Order flow saved as a new flow</description>
    <environments>Default</environments>
    <formulas>
        <name>roundOffContractTerm</name>
        <dataType>Number</dataType>
        <expression>ROUND({!Get_Quote.Contract_Term_Months__c},0)</expression>
        <scale>2</scale>
    </formulas>
