        <name>fx_Subject</name>
        <dataType>String</dataType>
        <expression>{!get_WorkOrder.RecordType.Name} &amp; &quot; - &quot; &amp; TEXT( {!get_WorkOrder.Request_Type__c} ) &amp; &quot; - &quot; &amp; IF(NOT(ISBLANK({!get_WorkOrder.Opportunity__c})),  {!get_WorkOrder.Opportunity__r.Name} , IF(NOT(ISBLANK({!get_WorkOrder.Project__c})) ,{!get_WorkOrder.Project__r.Name} ,  {!get_WorkOrder.Account.Name} ))</expression>
