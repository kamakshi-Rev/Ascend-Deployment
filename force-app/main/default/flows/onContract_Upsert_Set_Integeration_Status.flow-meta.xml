    <description>Initial Creation as part of Rev Cloud Implementation. This handles the logic for triggering integration to SNOW.</description>
    <environments>Default</environments>
    <formulas>
        <name>newlyActivated</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  ISNEW(),
  AND(
    TEXT({!$Record__Prior.Status}) != &apos;Activated&apos;,
    TEXT({!$Record__Prior.Status}) != &apos;Contract Expired&apos;,
    TEXT({!$Record__Prior.Status}) != &apos;Contract Terminated&apos;,
    TEXT({!$Record__Prior.Status}) != &apos;Onboarding&apos;
  )
)</expression>
    </formulas>
