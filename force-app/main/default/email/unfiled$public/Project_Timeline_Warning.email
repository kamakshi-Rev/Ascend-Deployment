<messaging:emailTemplate subject="Project Timeline is {!relatedTo.Timeline_Percent_Completed__c}% Complete: {!relatedTo.Name}" recipientType="User" relatedToType="SFDC_Projects__c">
<messaging:htmlEmailBody >
        <style type="text/css" font-family="verdana" font-size="12px">
            table {
            border-width: 2px;
            border-color: #FFFFFF;
            background-color: #FFFFFF;
            text-align: left;
            }

            td {
            border-width: 8px;
            padding: 0px;
            border-color: #000000;
            text-align: left;
            background-color: #FFffff;
            }

            th { 
            color: #000000;
            border-width: 0px ;
            width: 225px;
            padding: 0px ;
            border-color: #000000;
            text-align: left;
            background-color: #FFFFFF;
            }
        </style>
<body>
    <span style="color:#000000; font-weight:bold;">The following project has completed {!relatedTo.Timeline_Percent_Completed__c}% of it's projected timeline.</span><br/><br/>
    <table>
    <tbody>
                    <tr>
                        <th> Project: </th>
                        <td><a href="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+RelatedTo.ID}">{!relatedTo.Name}</a></td>
                    </tr>
                    <tr>
                        <th>Opportunity: </th>
                        <td><a href="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+RelatedTo.Opportunity__r.ID}">{!relatedTo.Opportunity__r.Name}</a></td>
                    </tr>
                    <tr>
                        <th>Project Lead: </th>
                        <td>{!relatedTo.Project_Lead__r.Name}</td>
                    </tr>
                    <tr>
                        <th>Sales Rep: </th>
                        <td>{!relatedTo.Sales_Rep__r.Name}</td>
                    </tr>
                    <tr>
                        <th style="color:#ffffff;"> *** </th>
                        <td style="color:#ffffff;"> *** </td>
                    </tr>
                    <tr>
                        <th>Start Date: </th>
                        <td>{!relatedTo.Start_Date__c}</td>
                    </tr>
                    <tr>
                        <th>End Date: </th>
                        <td>{!relatedTo.End_Date__c}</td>
                    </tr>
                    <tr>
                        <th>Timeline Percentgage Complete: </th>
                        <td>{!relatedTo.Timeline_Percent_Completed__c}%</td>
                    </tr>
    </tbody>
    </table><br/>
    </body>
</messaging:htmlEmailBody>
</messaging:emailTemplate>